{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "eslint.js",
    "prettier.js",
    "dotenv.js",
    "allure.js",
    "guardrails/*.js",
    "hooks/*.js",
    "modules.d.ts"
  ]
}
