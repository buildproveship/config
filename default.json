{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "buildproveship shared Renovate preset. Use it with: { \"extends\": [\"github>buildproveship/config\"] }",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":maintainLockFilesMonthly"
  ],
  "timezone": "Asia/Hong_Kong",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "labels": ["dependencies"],
  "npmrc": "@buildproveship:registry=https://npm.pkg.github.com/",
  "hostRules": [
    {
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.GH_PACKAGES_TOKEN }}"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Cost: one PR a week per repo for every non-major update (all dependency types).",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "One PR for GitHub Actions digest and version updates.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "All @buildproveship/* updates in one PR, never automerged.",
      "matchPackageNames": ["@buildproveship/*"],
      "groupName": "@buildproveship packages",
      "rangeStrategy": "bump",
      "automerge": false
    },
    {
      "description": "Design system: ui-web and tokens updates open at once, not on the weekly schedule, in their own PR, and merge when `ci` is green, so an app never sits behind the latest palette or components (RRDSCRUM-682).",
      "matchPackageNames": ["@buildproveship/ui-web", "@buildproveship/tokens"],
      "groupName": "design system",
      "schedule": ["at any time"],
      "minimumReleaseAge": null,
      "rangeStrategy": "bump",
      "automerge": true,
      "labels": ["dependencies", "design-system"]
    },
    {
      "description": "Lint, format and type-check tooling moves together.",
      "matchPackageNames": [
        "@buildproveship/config",
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "prettier",
        "typescript"
      ],
      "groupName": "code-quality tooling"
    },
    {
      "description": "Python tooling (observability).",
      "matchManagers": ["pep621", "pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python dependencies (non-major)"
    },
    {
      "description": "Node.js runtime pins (.nvmrc, engines) are an owner decision: one PR, never automerged.",
      "matchDepNames": ["node"],
      "groupName": "Node.js runtime"
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  }
}
