{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "releaseready-guardrails.json",
  "description": "Repo settings for releaseready-guardrails. Every exception carries a reason a reviewer can check.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "reason": {
      "type": "string",
      "minLength": 20,
      "pattern": "\\S[\\s\\S]{18,}\\S"
    },
    "specificReason": {
      "type": "string",
      "allOf": [
        { "$ref": "#/definitions/reason" },
        {
          "not": {
            "pattern": "^\\s*(TODO|[Tt]odo|TBD|[Pp]re-?existing|[Bb]aseline)\\b"
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "allow": {
      "description": "Findings that are correct here. Each entry names the rule, a path glob, optionally a substring of the offending line, and why (for legacy code: the current consumer). Entries that match nothing are errors.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "path", "reason"],
        "properties": {
          "rule": {
            "enum": [
              "dependency-source",
              "unpublished-internal-dependency",
              "tsconfig-private-path",
              "tsconfig-not-strict",
              "build-in-node-modules",
              "copied-schema-primitive",
              "copied-canonical-digest",
              "copied-jwt-verifier",
              "hand-written-archive-parser",
              "copied-wcag-contrast",
              "legacy-marker",
              "skipped-test",
              "runtime-assert",
              "hardcoded-tmp",
              "eslint-rule-off-without-reason",
              "readme-dated-history",
              "old-brand",
              "local-ui-component",
              "literal-colour",
              "tracked-ds-store",
              "tracked-build-output",
              "oversized-source-file",
              "suppression-without-reason",
              "argv-index"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "match": { "type": "string", "minLength": 3 },
          "max": { "type": "integer", "minimum": 1 },
          "reason": { "$ref": "#/definitions/specificReason" }
        }
      }
    },
    "jscpd": {
      "description": "Duplication settings. No repo may allow more than 1%; generated sources (built-in globs and fileLength.generated) are not counted.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "designSystem": {
      "description": "Opt-in design-system bypass check (design-lint rule 10). Files matching these globs must use @buildproveship/ui-web components and @buildproveship/tokens variables: a local component with a ui-web name (local-ui-component) or a literal colour (literal-colour) fails.",
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "fileLength": {
      "description": "oversized-source-file settings. A limit above 1000 lines needs a reason; every generated-file glob names why the file is generated, and neither the line limit nor jscpd counts those files.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLines": { "type": "integer", "minimum": 1 },
        "reason": { "$ref": "#/definitions/reason" },
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "$ref": "#/definitions/specificReason" }
            }
          }
        }
      },
      "if": {
        "required": ["maxLines"],
        "properties": {
          "maxLines": { "type": "integer", "exclusiveMinimum": 1000 }
        }
      },
      "then": { "required": ["reason"] }
    },
    "knip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "reason": { "$ref": "#/definitions/reason" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "if": {
        "required": ["enabled"],
        "properties": { "enabled": { "type": "boolean", "const": false } }
      },
      "then": { "required": ["reason"] }
    }
  }
}
