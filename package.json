{
  "name": "@releaseready/config",
  "version": "1.0.0",
  "description": "Shared ESLint flat config, Prettier config, strict tsconfig base and Renovate preset for releaseready repos.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releaseready/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "files": [
    "eslint.js",
    "prettier.js",
    "types",
    "tsconfig.json",
    "default.json"
  ],
  "exports": {
    "./eslint": {
      "types": "./types/eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier": {
      "types": "./types/prettier.d.ts",
      "default": "./prettier.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./renovate": "./default.json",
    "./package.json": "./package.json"
  },
  "prettier": "./prettier.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/*.test.js",
    "renovate:check": "renovate-config-validator --strict default.json renovate.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.30.4",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
