{
  "name": "@buildproveship/config",
  "version": "6.0.0",
  "description": "Shared ESLint flat config, Prettier config, strict tsconfig base, Renovate preset, the releaseready-guardrails checker and the buildproveship-code-quality skill for BuildProveShip repos.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildproveship/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": "^22.22.1 || >=24.0.0"
  },
  "packageManager": "npm@11.4.2",
  "files": [
    "eslint.js",
    "prettier.js",
    "types",
    "tsconfig.json",
    "default.json",
    "guardrails/*.js",
    "guardrails/config.schema.json",
    "skill",
    "hooks/*.js",
    "dotenv.js",
    "allure.js",
    "templates"
  ],
  "exports": {
    "./eslint": {
      "types": "./types/eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier": {
      "types": "./types/prettier.d.ts",
      "default": "./prettier.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./renovate": "./default.json",
    "./dotenv": {
      "types": "./types/dotenv.d.ts",
      "default": "./dotenv.js"
    },
    "./allure": {
      "types": "./types/allure.d.ts",
      "default": "./allure.js"
    },
    "./templates/AGENTS.md": "./templates/AGENTS.md",
    "./templates/CLAUDE.md": "./templates/CLAUDE.md",
    "./templates/copilot-instructions.md": "./templates/copilot-instructions.md",
    "./package.json": "./package.json",
    "./guardrails": {
      "types": "./types/guardrails/index.d.ts",
      "default": "./guardrails/index.js"
    },
    "./guardrails/config.schema.json": "./guardrails/config.schema.json",
    "./lint-staged": {
      "types": "./types/hooks/lint-staged.config.d.ts",
      "default": "./hooks/lint-staged.config.js"
    }
  },
  "prettier": "./prettier.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/*.test.js",
    "renovate:check": "npx --yes --package renovate@44.251.0 -- sh -c 'renovate-config-validator --strict default.json renovate.json && npm run --silent renovate:policy -- --renovate-bin \"$(command -v renovate)\"'",
    "renovate:policy": "node scripts/check-renovate-policy.js",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run check:guardrails && npm run check:workflow-cost",
    "check:guardrails": "node guardrails/cli.js",
    "check:workflow-cost": "node scripts/check-workflow-cost.js",
    "prepare": "node hooks/cli.js install",
    "check:full": "npm run check && npm run renovate:check",
    "release:evidence": "node scripts/check-release-evidence.js",
    "release:check": "node scripts/check-release-policy.js"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.4",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "dotenv": "18.0.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "jsonc-parser": "3.3.1",
    "knip": "6.46.1",
    "lint-staged": "17.6.1",
    "minimatch": "11.0.9",
    "ts-api-utils": "2.5.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "bin": {
    "releaseready-guardrails": "./guardrails/cli.js",
    "releaseready-hooks": "./hooks/cli.js"
  }
}
