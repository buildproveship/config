{
  "name": "@releaseready/config",
  "version": "2.2.4",
  "description": "Shared ESLint flat config, Prettier config, strict tsconfig base, Renovate preset, the releaseready-guardrails checker and the releaseready-code-quality skill for releaseready repos.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releaseready/config.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "npm@11.4.2",
  "files": [
    "eslint.js",
    "prettier.js",
    "types",
    "tsconfig.json",
    "default.json",
    "guardrails/*.js",
    "guardrails/config.schema.json",
    "skill"
  ],
  "exports": {
    "./eslint": {
      "types": "./types/eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier": {
      "types": "./types/prettier.d.ts",
      "default": "./prettier.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./renovate": "./default.json",
    "./package.json": "./package.json",
    "./guardrails": {
      "types": "./types/guardrails/index.d.ts",
      "default": "./guardrails/index.js"
    },
    "./guardrails/config.schema.json": "./guardrails/config.schema.json"
  },
  "prettier": "./prettier.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/*.test.js",
    "renovate:check": "npx --yes --package renovate@44.251.0 -- renovate-config-validator --strict default.json renovate.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run check:guardrails",
    "check:guardrails": "node guardrails/cli.js"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.4",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "jsonc-parser": "3.3.1",
    "knip": "6.46.1",
    "minimatch": "11.0.9",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "bin": {
    "releaseready-guardrails": "./guardrails/cli.js"
  }
}
