{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Fixtures hold deliberate violations that only the tests read, by path.
  "ignore": ["test/fixtures/**"],
  // jscpd is started by path from guardrails/index.js (binPath), which knip cannot see.
  "ignoreDependencies": ["jscpd"],
  // gitleaks is a system binary: the pre-commit hook runs it and test/hooks.test.js needs it installed (brew, or the
  // pinned download in the security-scan action).
  "ignoreBinaries": ["gitleaks"],
}
