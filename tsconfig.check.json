{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "*.js",
    "modules.d.ts",
    "guardrails/*.js",
    "hooks/*.js",
    "test/**/*.js"
  ],
  "exclude": ["test/fixtures/**"]
}
